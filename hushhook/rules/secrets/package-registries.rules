# Package and container registries.

id: npm-token
pattern: \bnpm_[A-Za-z0-9]{36}\b
matches: npm_{a*36}
ignores: npm_config_registry

id: pypi-token
pattern: \bpypi-Ag[A-Za-z0-9_-]{50,}
matches: pypi-AgEI{a*60}
ignores: pypi-token-here

id: rubygems-token
pattern: \brubygems_[a-f0-9]{48}\b
matches: rubygems_{a*48}
ignores: rubygems_short

id: dockerhub-token
pattern: \bdckr_pat_[A-Za-z0-9_-]{27,}
matches: dckr_pat_{a*27}
ignores: dckr_pat_short
