# Formats that are not tied to one service.

id: jwt
pattern: \beyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}
matches: eyJ{a*20}.eyJ{a*20}.{a*20}
ignores: eyJ.eyJ.short

# The body field masks the lines after the header, up to the first line that is
# not key material. The END line stays, since it reveals nothing.
id: pem-private-key
pattern: (?m)-----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----[ \t\r]*$
body: ^(?:[A-Za-z0-9+/=]*|(?:Proc-Type|DEK-Info|Version|Comment):.*)[ \t\r]*$
matches: {-*5}BEGIN RSA PRIVATE KEY{-*5}
matches: {-*5}BEGIN OPENSSH PRIVATE KEY{-*5}
matches: {-*5}BEGIN PGP PRIVATE KEY BLOCK{-*5}
ignores: {-*5}BEGIN PUBLIC KEY{-*5}
ignores: {-*5}BEGIN CERTIFICATE{-*5}

# The same key squeezed onto one line, as in a service account JSON file.
id: pem-private-key-inline
pattern: -----BEGIN (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----(?:\\[nr]|[A-Za-z0-9+/=]){16,}(?:-----END (?:[A-Z0-9]+ )*PRIVATE KEY(?: BLOCK)?-----)?
matches: "private_key": "{-*5}BEGIN PRIVATE KEY{-*5}\n{a*64}\n{-*5}END PRIVATE KEY{-*5}\n"
ignores: BEGIN = "{-*5}BEGIN PRIVATE KEY{-*5}"

id: database-url-password
pattern: (?i)\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\+srv)?|rediss?|amqps?|mssql|sqlserver|clickhouse)://[^\s:/@"']*:(?P<secret>(?!\$|<|\{|%\(|%s@)[^\s@/"']+)@
matches: postgres://app:{x*12}@db.example.com:5432/app
matches: mongodb+srv://app:{x*12}@cluster0.example.net/app
matches: redis://:{x*12}@cache.example.com:6379/0
ignores: postgres://localhost:5432/app
ignores: postgres://app:${DB_PASSWORD}@db.example.com/app
ignores: mysql://app:<password>@db.example.com/app

id: url-basic-auth
pattern: \bhttps?://[^\s:/@"']+:(?P<secret>(?!\$|<|\{|%\(|%s@)[^\s@/"']{3,})@
matches: https://deploy:{x*16}@git.example.com/app.git
ignores: https://example.com:8443/path@v2
ignores: https://user:$TOKEN@example.com/
ignores: https://user:<password>@example.com/

id: http-bearer-token
pattern: (?i)\bauthorization["']?\s*[:=]\s*["']?bearer\s+(?P<secret>[A-Za-z0-9._~+/-]{20,}=*)
matches: Authorization: Bearer {a1*16}
matches: "authorization": "Bearer {a1*16}"
ignores: Authorization: Bearer $TOKEN
ignores: Authorization: Bearer <token>

id: http-basic-auth
pattern: (?i)\bauthorization["']?\s*[:=]\s*["']?basic\s+(?P<secret>[A-Za-z0-9+/]{12,}={0,2})
matches: Authorization: Basic {a1*12}==
ignores: Authorization: Basic $CREDENTIALS

id: age-secret-key
pattern: \bAGE-SECRET-KEY-1[0-9A-Z]{58}\b
matches: AGE-SECRET-KEY-1{Q*58}
ignores: AGE-SECRET-KEY-1SHORT
