# Email and SMS services.

id: twilio-api-key
pattern: \bSK[0-9a-f]{32}\b
matches: SK{a*32}
ignores: SKIP-this-step

id: twilio-auth-token
pattern: (?i)twilio[_-]?auth[_-]?token["'\s:=]+(?P<secret>[0-9a-f]{32})\b
matches: TWILIO_AUTH_TOKEN={a*32}
ignores: TWILIO_AUTH_TOKEN=$TOKEN

id: sendgrid-api-key
pattern: \bSG\.[A-Za-z0-9_-]{22}\.[A-Za-z0-9_-]{43}(?![A-Za-z0-9_-])
matches: SG.{a*22}.{a*43}
ignores: SG.example
