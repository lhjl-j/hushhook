# Slack, Discord and Telegram.

id: slack-token
pattern: \bxox[abeoprs]-[A-Za-z0-9-]{10,}
matches: xoxb-{1*11}-{1*12}-{a*24}
matches: xoxp-{1*11}-{1*12}-{a*32}
ignores: xoxo-hugs

id: slack-app-token
pattern: \bxapp-[0-9]-[A-Z0-9]+-[0-9]+-[a-z0-9]+
matches: xapp-1-A{A*10}-{1*13}-{a*32}
ignores: xapp-demo

id: slack-webhook-url
pattern: https://hooks\.slack\.com/(?:services|workflows)/[A-Za-z0-9/_-]{20,}
matches: https://hooks.slack.com/services/T{A*8}/B{A*8}/{a*24}
ignores: https://hooks.slack.com/services/

id: discord-bot-token
pattern: \b[MNO][A-Za-z0-9_-]{23,27}\.[A-Za-z0-9_-]{6}\.[A-Za-z0-9_-]{27,40}
matches: M{a*23}.{a*6}.{a*27}
ignores: Mock.method.name

id: discord-webhook-url
pattern: https://(?:ptb\.|canary\.)?discord(?:app)?\.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]{30,}
matches: https://discord.com/api/webhooks/{1*18}/{a*68}
ignores: https://discord.com/api/webhooks/

id: telegram-bot-token
pattern: \b[0-9]{8,10}:AA[A-Za-z0-9_-]{33}(?![A-Za-z0-9_-])
matches: {1*10}:AA{a*33}
ignores: 12345678:AAshort
