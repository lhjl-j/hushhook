# GitHub and GitLab.

id: github-classic-token
pattern: \bghp_[A-Za-z0-9]{36}\b
matches: ghp_{a*36}
ignores: ghp_short

id: github-fine-grained-token
pattern: \bgithub_pat_[A-Za-z0-9_]{60,}\b
matches: github_pat_{a*22}_{a*59}
ignores: github_pat_short

id: github-app-token
pattern: \bgh[ousr]_[A-Za-z0-9]{36}\b
matches: gho_{a*36}
matches: ghs_{a*36}
ignores: ghs_short

id: gitlab-personal-token
pattern: \bglpat-[A-Za-z0-9_.-]{20,}
matches: glpat-{a*20}
ignores: glpat-short

id: gitlab-runner-token
pattern: \bglrt-[A-Za-z0-9_.-]{20,}
matches: glrt-{a*20}
ignores: glrt-short
