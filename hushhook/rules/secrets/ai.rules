# Model providers and AI services.

id: anthropic-api-key
pattern: \bsk-ant-[A-Za-z0-9_-]{32,}
matches: sk-ant-api03-{a*40}
ignores: sk-ant-short

id: openai-api-key
pattern: \bsk-(?!ant-)(?:proj-|svcacct-|admin-)?(?=[A-Za-z0-9_-]*[0-9])[A-Za-z0-9_-]{32,}
matches: sk-{a1*24}
matches: sk-proj-{a1*30}
ignores: sk-learn-contrib-imbalanced-learn-extras
ignores: sk-short1

id: huggingface-token
pattern: \bhf_[A-Za-z0-9]{34,}\b
matches: hf_{a*34}
ignores: hf_hub_download

id: replicate-token
pattern: \br8_[A-Za-z0-9]{37,}\b
matches: r8_{a*37}
ignores: r8_short

id: groq-api-key
pattern: \bgsk_[A-Za-z0-9]{50,}\b
matches: gsk_{a*52}
ignores: gsk_short
