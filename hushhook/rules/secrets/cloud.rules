# Cloud providers and infrastructure tools.

id: aws-access-key-id
pattern: \b(?:AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}\b
matches: AKIA{A*16}
matches: ASIA{A*16}
ignores: AKIA is a prefix

id: aws-secret-access-key
pattern: (?i)aws[_-]?secret[_-]?access[_-]?key["'\s:=]+(?P<secret>[A-Za-z0-9/+=]{40})(?![A-Za-z0-9/+=])
matches: aws_secret_access_key = {a*40}
matches: "AWS_SECRET_ACCESS_KEY": "{a*40}"
ignores: aws_secret_access_key = ${AWS_SECRET_ACCESS_KEY}

id: google-api-key
pattern: \bAIza[0-9A-Za-z_-]{35}(?![0-9A-Za-z_-])
matches: AIza{a*35}
ignores: AIza{a*20}

id: google-oauth-client-secret
pattern: \bGOCSPX-[A-Za-z0-9_-]{28}(?![A-Za-z0-9_-])
matches: GOCSPX-{a*28}
ignores: GOCSPX-short

id: gcp-service-account-key-id
pattern: "private_key_id"\s*:\s*"(?P<secret>[0-9a-f]{40})"
matches: "private_key_id": "{a*40}"
ignores: "private_key_id": "${KEY_ID}"

id: azure-storage-account-key
pattern: (?i)\bAccountKey=(?P<secret>[A-Za-z0-9+/=]{40,})
matches: DefaultEndpointsProtocol=https;AccountName=demo;AccountKey={a*86}==;EndpointSuffix=core.windows.net
ignores: AccountKey=<your-key>

id: digitalocean-token
pattern: \bdo[opr]_v1_[a-f0-9]{64}\b
matches: dop_v1_{a*64}
ignores: dop_v1_short

id: vault-token
pattern: \bhvs\.[A-Za-z0-9_-]{24,}
matches: hvs.{a*90}
ignores: hvs.short

id: terraform-cloud-token
pattern: \b[A-Za-z0-9]{14}\.atlasv1\.[A-Za-z0-9_-]{60,}
matches: {a*14}.atlasv1.{a*67}
ignores: demo.atlasv1.short
