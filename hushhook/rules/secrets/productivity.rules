# Notion integration tokens. Current personal access tokens start with ntn_;
# older internal-integration tokens used secret_. Notion's docs do not publish
# a fixed length, so both patterns require the distinctive prefix plus a bounded
# run of 32-64 alphanumeric characters. That keeps ordinary identifiers such as
# secret_key_base out of the mask.

id: notion-integration-token
pattern: \bntn_[A-Za-z0-9]{32,64}\b
matches: ntn_{a*43}
matches: NOTION_API_KEY=ntn_{b1*16}
ignores: ntn_short
ignores: NOTION_API_KEY=ntn_...

id: notion-legacy-integration-token
pattern: \bsecret_[A-Za-z0-9]{32,64}\b
matches: secret_{a*43}
ignores: secret_key_base
ignores: secret_manager
ignores: secret_{a*8}
