# Commands that run unseen code or wipe a machine.

id: pipe-download-to-shell
pattern: \b(?:curl|wget|fetch)\b[^\n;]*\|\s*(?:sudo\s+(?:-\S+\s+)*)?(?:env\s+\S+\s+)?(?:ba|z|k|da|fi)?sh\b
reason: this runs a download without anyone reading it. Download it to a file and read it first.
matches: curl -fsSL https://example.com/install.sh | sh
matches: wget -qO- https://example.com/install.sh | sudo bash
ignores: curl -s https://example.com/data.json | sha256sum
ignores: curl -s https://example.com/data.json | jq .name

id: pipe-download-to-interpreter
pattern: \b(?:curl|wget|fetch)\b[^\n;]*\|\s*(?:sudo\s+(?:-\S+\s+)*)?(?:python[0-9.]*|perl|ruby|node)(?:\s+-)?(?=\s*(?:$|[;&|\n]))
reason: this runs a download without anyone reading it. Download it to a file and read it first.
matches: curl -fsSL https://example.com/setup.py | python3
matches: curl -fsSL https://example.com/setup.py | python3 -
ignores: curl -s https://example.com/data.json | python3 -m json.tool

id: shell-runs-download
pattern: (?:\beval\s+|\b(?:ba|z|da)?sh\s+(?:-c\s+)?)["']?(?:\$\(|<\()\s*(?:curl|wget)\b
reason: this runs a download without anyone reading it. Download it to a file and read it first.
matches: bash -c "$(curl -fsSL https://example.com/install.sh)"
matches: bash <(curl -fsSL https://example.com/install.sh)
matches: eval "$(wget -qO- https://example.com/env.sh)"
ignores: curl -fsSL https://example.com/install.sh -o install.sh
ignores: echo "$(curl -s https://example.com/version)"

id: rm-rf-root
pattern: \brm\s+(?=(?:[^\n;|&]*\s)?(?:-[a-zA-Z]*[rR][a-zA-Z]*|--recursive)(?:\s|$))(?:[^\n;|&]*\s)?["']?/\*?["']?(?=\s|$|[;|&])
reason: this deletes the whole filesystem.
matches: rm -rf /
matches: rm -fr /*
matches: rm --recursive --force /
ignores: rm -rf /tmp/build
ignores: rm -rf ./build
ignores: rm -f /

id: rm-rf-home
pattern: \brm\s+(?=(?:[^\n;|&]*\s)?(?:-[a-zA-Z]*[rR][a-zA-Z]*|--recursive)(?:\s|$))(?:[^\n;|&]*\s)?["']?(?:~|\$HOME|\$\{HOME\})/?\*?["']?(?=\s|$|[;|&])
reason: this deletes the whole home folder.
matches: rm -rf ~
matches: rm -rf ~/*
matches: rm -rf "$HOME"
matches: rm -r ${HOME}/
ignores: rm -rf ~/project/build
ignores: rm -rf "$HOME/.cache/app"

id: dd-to-disk
pattern: \bdd\b[^\n;|&]*\bof=/dev/(?:sd|hd|vd|xvd|nvme|mmcblk|disk)
reason: this writes straight over a disk.
matches: dd if=image.iso of=/dev/sda bs=4M
ignores: dd if=/dev/zero of=test.img bs=1M count=10

id: mkfs-on-disk
pattern: \bmkfs(?:\.[a-z0-9]+)?\s[^\n;|&]*/dev/
reason: this formats a disk and erases what is on it.
matches: mkfs.ext4 /dev/sdb1
ignores: mkfs.ext4 test.img

id: chmod-777-root
pattern: \bchmod\s+(?:-\S+\s+)*(?:0?777|a\+rwx)\s+/(?:\s|$)
reason: this opens the whole filesystem to every user.
matches: chmod -R 777 /
ignores: chmod 777 ./tmp
