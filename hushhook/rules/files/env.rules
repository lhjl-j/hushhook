# Environment files.

id: dotenv
glob: .env
glob: .env.*
except: .env.example
except: .env.sample
except: .env.template
except: .env.dist
except: .env.defaults
matches: .env
matches: app/.env.production
ignores: .env.example
ignores: environment.py

id: direnv
glob: .envrc
matches: project/.envrc
ignores: envrc.md

id: wrangler-dev-vars
glob: .dev.vars
matches: worker/.dev.vars
ignores: dev.vars.md
